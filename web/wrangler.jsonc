{
    // Sidekick's web UI is a static site and nothing else: no `main` entry
    // point, no bindings, no KV/D1/R2/Durable Objects. Cloudflare serves the
    // files beside this config and never sees a byte of anyone's config -- that
    // stays on the player's own disk and is read by the browser, not by this
    // Worker.
    "name": "sidekick",
    // The token can see more than one account, so name the one this deploys to
    // -- without it `wrangler deploy` cannot pick and bails out. It also fixes
    // the workers.dev subdomain below, which is per-account.
    "account_id": "1d01891f2b3c881b2716dfdbb78d58f3",
    "compatibility_date": "2026-09-01",
    // The account's own workers.dev subdomain, giving
    // https://sidekick.xiim-app.workers.dev -- the address /sk webui open
    // defaults to. A `sidekick.xiim.app` Custom Domain would be nicer, but that
    // needs xiim.app to be an *active* zone on the account above; today the
    // active xiim.app zone sits on a different account and the copy here is
    // stuck pending, so a custom_domain route resolves to nothing. Move the
    // zone, then swap this for:
    //   "routes": [{ "pattern": "sidekick.xiim.app", "custom_domain": true }]
    "workers_dev": true,
    "assets": {
        // This directory, minus what `.assetsignore` holds back (this file and
        // package.json, which are tooling, not site content).
        "directory": "."
        // No not_found_handling: the app has no router and no deep links, and
        // "single-page-application" turns every 404 into a 200 carrying
        // index.html -- which the service worker would then cache as HTML under
        // a renamed asset's old URL.
    }
}
